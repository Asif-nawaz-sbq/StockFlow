# Copy to .env before running docker compose. Values below are local-only.
# Nothing in here is used in AWS - staging/production pull from Secrets Manager.

COMPOSE_PROJECT_NAME=stockflow

# --- Postgres ---
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow_local_pw
POSTGRES_DB=stockflow
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API ---
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgres://stockflow:stockflow_local_pw@postgres:5432/stockflow
REDIS_URL=redis://redis:6379

# Generate your own: openssl rand -hex 48
JWT_ACCESS_SECRET=dev_access_secret_change_me_0000000000000000000000000000
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_000000000000000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# --- Web ---
WEB_PORT=3000
# Browser-side calls (must be reachable from the host)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side calls from the Next container (container DNS)
API_INTERNAL_URL=http://api:3001

# --- Seed login (dev only) ---
SEED_OWNER_EMAIL=a.brenner@nordmann-handel.de
SEED_OWNER_PASSWORD=Sommer2026!
